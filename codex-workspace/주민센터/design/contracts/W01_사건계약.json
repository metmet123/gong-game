  "sources": [
    {
      "id": "S01",
      "title": "이웃의 도움 요청",
      "authorId": "P3",
      "recordedAt": "D1",
      "effectivePeriod": "최근 며칠",
      "initiallyAvailable": true,
      "statements": [
        {
          "id": "E01",
          "text": "식사를 거르는 날이 보여 걱정된다. 사정은 당사자에게 확인해 달라.",
          "supports": [
            "concern-meal"
          ],
          "doesNotEstablish": [
            "living-alone",
            "meal-cause"
          ]
        }
      ]
    },
    {
      "id": "S02",
      "title": "이전 상담 기록",
      "authorId": "resident-center",
      "recordedAt": "D-90",
      "effectivePeriod": "D-90 당시",
      "initiallyAvailable": true,
      "statements": [
        {
          "id": "E02",
          "text": "김하나는 박정임의 딸이다.",
          "supports": [
            "daughter-of"
          ]
        },
        {
          "id": "E03",
          "text": "당시 두 사람은 같은 집에 거주했다.",
          "supports": [
            "past-cohabiting"
          ],
          "doesNotEstablish": [
            "current-cohabiting"
          ]
        }
      ]
    },
    {
      "id": "S03",
      "title": "당사자의 현재 생활",
      "authorId": "P1",
      "recordedAt": "D1",
      "effectivePeriod": "현재",
      "initiallyAvailable": false,
      "statements": [
        {
          "id": "E04",
          "text": "딸은 지난달 다른 지역으로 옮겼고 현재 혼자 지낸다.",
          "supports": [
            "living-alone",
            "not-current-cohabiting"
          ]
        },
        {
          "id": "E05",
          "text": "장보기와 식사 준비가 어렵다.",
          "supports": [
            "meal-preparation-need"
          ]
        },
        {
          "id": "E06",
          "text": "딸에게 확인하고 식사 지원 상담을 연결하는 데 동의한다.",
          "supports": [
            "consent-contact-daughter",
            "consent-meal-referral"
          ]
        }
      ]
    },
    {
      "id": "S04",
      "title": "딸의 도움 범위",
      "authorId": "P2",
      "recordedAt": "D1",
      "effectivePeriod": "현재",
      "initiallyAvailable": false,
      "statements": [
        {
          "id": "E07",
          "text": "다른 지역에서 살며 저녁마다 전화로 연락한다.",
          "supports": [
            "not-current-cohabiting",
            "phone-contact"
          ]
        },
        {
          "id": "E08",
          "text": "매일 방문하는 도움은 제공할 수 없다.",
          "supports": [
            "no-daily-visits"
          ]
        }
      ]
    },
    {
      "id": "S05",
      "title": "모퉁이복지관 안내",
      "authorId": "O1",
      "recordedAt": "D1",
      "effectivePeriod": "현재 가상 서비스 안내",
      "initiallyAvailable": true,
      "statements": [
        {
          "id": "E09",
          "text": "동의한 주민의 식사 지원 상담을 접수한다. 제공 여부와 일정은 상담 후 기관에서 확인한다.",
          "supports": [
            "meal-consultation-route"
          ],
          "doesNotEstablish": [
            "service-approved"
          ]
        }
      ]
    }
  ],
  "questions": [
